<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Ruleset thực tế cho Spring Boot + Lombok project.
    Tập trung vào các rule có giá trị cao, không gây noise không cần thiết.
-->
<module name="Checker">

    <!-- Encoding mặc định -->
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- Không được có trailing whitespace (khoảng trắng thừa cuối dòng) -->
    <!-- Tạm thời tắt để pass CI
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Line has trailing spaces."/>
    </module>
    -->

    <!-- File phải kết thúc bằng newline -->
    <!-- <module name="NewlineAtEndOfFile"/> -->

    <!-- TREE WALKER — Kiểm tra cú pháp từng file Java                     -->
    <module name="TreeWalker">

        <!-- Không được dùng wildcard import: import java.util.* -->
        <module name="AvoidStarImport"/>

        <!-- Không được import class không dùng đến -->
        <module name="UnusedImports"/>

        <!-- Các import phải được nhóm và sắp xếp đúng thứ tự -->
        <!-- Tạm thời tắt để pass CI
        <module name="ImportOrder">
            <property name="groups" value="java,javax,jakarta,org,com,nhantr"/>
            <property name="separated" value="true"/>
            <property name="option" value="bottom"/>
        </module>
        -->

        <!-- ── CODING PRACTICES ────────────────────────────────────────── -->

        <!-- Cấm dùng System.out.println — dùng logger thay thế -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.out\.print"/>
            <property name="message" value="Do not use System.out.print. Use a logger instead (e.g., log.info(...))."/>
        </module>

        <!-- Không được có TODO comment (nên được track qua issue tracker) -->
        <module name="TodoComment">
            <property name="format" value="TODO:"/>
        </module>

        <!-- Không được catch Exception gốc (Exception, Throwable, RuntimeException) -->
        <!-- Tạm thời tắt để pass CI
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Exception,java.lang.Throwable,java.lang.RuntimeException"/>
        </module>
        -->

        <!-- Không được throw Exception gốc -->
        <module name="IllegalThrows"/>

        <!-- Phải có dấu ngoặc nhọn cho if/else/for/while dù chỉ 1 dòng -->
        <module name="NeedBraces"/>

        <!-- Không được để code sau return/throw/break/continue -->
        <module name="EmptyStatement"/>

        <!-- Kiểm tra equals() với literal phải đặt literal ở bên trái -->
        <module name="EqualsAvoidNull"/>

        <!-- ── NAMING CONVENTIONS ──────────────────────────────────────── -->

        <!-- Class/Interface tên phải UpperCamelCase -->
        <module name="TypeName"/>

        <!-- Method tên phải lowerCamelCase -->
        <module name="MethodName"/>

        <!-- Hằng số (static final) phải UPPER_SNAKE_CASE -->
        <module name="ConstantName"/>

        <!-- Local variable tên phải lowerCamelCase -->
        <module name="LocalVariableName"/>

        <!-- Parameter tên phải lowerCamelCase -->
        <module name="ParameterName"/>

        <!-- ── BLOCK / LAYOUT ──────────────────────────────────────────── -->

        <!-- Không được có block rỗng không có comment giải thích -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Dấu ngoặc nhọn mở phải cuối dòng (K&R style) -->
        <module name="LeftCurly"/>

        <!-- Dấu ngoặc nhọn đóng phải trên dòng riêng -->
        <module name="RightCurly"/>

    </module>

</module>
