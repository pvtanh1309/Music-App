# =============================================
# Music-App Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!
# =============================================

# Stage Configuration
SPRING_PROFILES_ACTIVE=local

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=MusicAppDB
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=org.postgresql.Driver
DB_SSLMODE=disable

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Mail Configuration (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=

# Port Configuration
APP_PORT=8080
FRONTEND_PORT=80
